{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-db",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "reveal": "silent" }
    },
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/backend/SpreeExpress.Api/SpreeExpress.Api.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__khong_bao_gio_khop__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in|Local:"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "start-all",
      "dependsOn": ["docker-db", "frontend", "build-api"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
